@model StudentApp.Models.OgrenciUyelikYenileme

@{
  ViewData["Title"] = "Yenileme Detaylarý";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-10">
       <div class="card shadow-lg border-0">
     <div class="card-header bg-info text-white">
      <h4 class="mb-0">
     <i class="fas fa-info-circle me-2"></i>Üyelik Yenileme Detaylarý
    </h4>
    </div>
        <div class="card-body">
      <!-- Öðrenci Bilgileri -->
     <div class="row mb-4">
<div class="col-md-12">
        <h5 class="border-bottom pb-2 mb-3">
      <i class="fas fa-user me-2 text-primary"></i>Öðrenci Bilgileri
          </h5>
       <div class="row">
        <div class="col-md-6">
    <p class="mb-2">
       <strong>Öðrenci:</strong>
      <a asp-controller="Ogrenciler" asp-action="Details" asp-route-id="@Model.OgrenciId" class="text-decoration-none">
          @Model.Ogrenci.OgrenciAdi @Model.Ogrenci.OgrenciSoyadi
      <i class="fas fa-external-link-alt ms-1 small"></i>
   </a>
       </p>
       <p class="mb-2">
    <strong>Yenileme Tarihi:</strong>
        <i class="fas fa-calendar-alt me-1"></i>
    @Model.YenilemeTarihi.ToString("dd.MM.yyyy HH:mm")
  </p>
  <p class="mb-2">
  <strong>Yenileme Baþlangýcý:</strong>
     @Model.YenilemeBaslangicTarihi.ToString("dd.MM.yyyy")
        </p>
  </div>
     <div class="col-md-6">
  <p class="mb-2">
      <strong>Yenileyen Kullanýcý:</strong>
   @(Model.YenileyenKullanici ?? "Sistem")
    </p>
 <p class="mb-2">
        <strong>Otomatik Yenileme:</strong>
@if (Model.OtomatikYenileme)
    {
     <span class="badge bg-info"><i class="fas fa-robot me-1"></i>Otomatik</span>
  }
  else
 {
   <span class="badge bg-warning"><i class="fas fa-user me-1"></i>Manuel</span>
   }
 </p>
 <p class="mb-2">
    <strong>Durum:</strong>
   @switch (Model.Durum)
 {
    case StudentApp.Models.YenilemeDurumuEnum.Aktif:
      <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>Aktif</span>
     break;
        case StudentApp.Models.YenilemeDurumuEnum.Tamamlandi:
    <span class="badge bg-info"><i class="fas fa-flag-checkered me-1"></i>Tamamlandý</span>
   break;
        case StudentApp.Models.YenilemeDurumuEnum.IptalEdildi:
  <span class="badge bg-danger"><i class="fas fa-times-circle me-1"></i>Ýptal Edildi</span>
   break;
     }
 </p>
   </div>
      </div>
   </div>
     </div>

       <hr class="my-4" />

      <!-- Ödeme Planý Karþýlaþtýrmasý -->
      <div class="row mb-4">
     <div class="col-md-12">
       <h5 class="border-bottom pb-2 mb-3">
     <i class="fas fa-exchange-alt me-2 text-primary"></i>Ödeme Planý Deðiþikliði
   </h5>
     </div>
   <div class="col-md-6">
  <div class="card bg-light">
 <div class="card-header bg-secondary text-white">
    <h6 class="mb-0">
  <i class="fas fa-clock-rotate-left me-2"></i>Eski Dönem
 </h6>
    </div>
       <div class="card-body">
 <p class="mb-2">
  <strong>Ödeme Planý:</strong><br/>
     <span class="badge bg-secondary fs-6">@Model.EskiOdemePlani.KursProgrami</span>
   </p>
       <p class="mb-2">
    <strong>Toplam Tutar:</strong><br/>
      <span class="text-muted fs-5"><span style="font-family: Arial, sans-serif;">&#8378;</span> @Model.EskiDonemToplamTutar.ToString("N2")</span>
  </p>
    <p class="mb-2">
    <strong>Kalan Borç:</strong><br/>
  @if (Model.EskiDonemKalanBorc > 0)
  {
       <span class="text-danger fs-5"><span style="font-family: Arial, sans-serif;">&#8378;</span> @Model.EskiDonemKalanBorc.ToString("N2")</span>
   }
 else
     {
  <span class="text-success fs-5">Yok</span>
      }
  </p>
       <p class="mb-0">
     <strong>Taksit Bilgisi:</strong><br/>
       <span class="badge bg-info">@Model.EskiOdemePlani.TaksitSayisi Taksit</span>
    <span class="badge bg-info"><span style="font-family: Arial, sans-serif;">&#8378;</span> @Model.EskiOdemePlani.TaksitTutari.ToString("N2") / Taksit</span>
      </p>
 </div>
     </div>
 </div>
 <div class="col-md-6">
  <div class="card bg-light border-primary">
       <div class="card-header bg-primary text-white">
     <h6 class="mb-0">
    <i class="fas fa-arrow-right me-2"></i>Yeni Dönem
      </h6>
   </div>
    <div class="card-body">
    <p class="mb-2">
  <strong>Ödeme Planý:</strong><br/>
 <span class="badge bg-primary fs-6">@Model.YeniOdemePlani.KursProgrami</span>
      </p>
 <p class="mb-2">
       <strong>Toplam Tutar:</strong><br/>
   <span class="text-success fs-5"><span style="font-family: Arial, sans-serif;">&#8378;</span> @Model.YeniDonemToplamTutar.ToString("N2")</span>
     </p>
     @if (Model.IndirimTutari.HasValue && Model.IndirimTutari.Value > 0)
  {
<p class="mb-2">
        <strong>Ýndirim:</strong><br/>
        <span class="badge bg-warning text-dark fs-6">
<i class="fas fa-tag me-1"></i><span style="font-family: Arial, sans-serif;">&#8378;</span> @Model.IndirimTutari.Value.ToString("N2")
   </span>
    @if (!string.IsNullOrEmpty(Model.IndirimAciklama))
  {
   <br/><small class="text-muted">@Model.IndirimAciklama</small>
   }
    </p>
   }
  <p class="mb-0">
       <strong>Taksit Bilgisi:</strong><br/>
       <span class="badge bg-info">@Model.YeniOdemePlani.TaksitSayisi Taksit</span>
  <span class="badge bg-info"><span style="font-family: Arial, sans-serif;">&#8378;</span> @Model.YeniOdemePlani.TaksitTutari.ToString("N2") / Taksit</span>
  </p>
   </div>
  </div>
     </div>
 </div>

      <hr class="my-4" />

   <!-- Özet Bilgiler -->
     <div class="row mb-4">
 <div class="col-md-12">
      <h5 class="border-bottom pb-2 mb-3">
   <i class="fas fa-chart-line me-2 text-primary"></i>Finansal Özet
     </h5>
 </div>
        <div class="col-md-4">
      <div class="card text-center">
 <div class="card-body">
      <h6 class="text-muted">Eski Dönem Toplam</h6>
  <h4 class="text-muted"><span style="font-family: Arial, sans-serif;">&#8378;</span> @Model.EskiDonemToplamTutar.ToString("N2")</h4>
  </div>
   </div>
     </div>
 <div class="col-md-4">
    <div class="card text-center border-warning">
   <div class="card-body">
       <h6 class="text-muted">Taþýnan Borç</h6>
 <h4 class="text-danger"><span style="font-family: Arial, sans-serif;">&#8378;</span> @Model.EskiDonemKalanBorc.ToString("N2")</h4>
      </div>
  </div>
   </div>
 <div class="col-md-4">
        <div class="card text-center border-success">
   <div class="card-body">
   <h6 class="text-muted">Yeni Dönem Toplam</h6>
    <h4 class="text-success"><span style="font-family: Arial, sans-serif;">&#8378;</span> @Model.YeniDonemToplamTutar.ToString("N2")</h4>
@if (Model.IndirimTutari.HasValue && Model.IndirimTutari.Value > 0)
       {
         <small class="text-muted">(Ýndirim uygulandý)</small>
    }
   </div>
   </div>
        </div>
  </div>

    @if (Model.EskiDonemKalanBorc > 0)
 {
   <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle me-2"></i>
  <strong>Dikkat:</strong> Eski dönem kalan borcu (<span style="font-family: Arial, sans-serif;">&#8378;</span>@Model.EskiDonemKalanBorc.ToString("N2")) 
    yeni dönem ilk taksitine eklenmiþtir.
   </div>
   }

    <div class="d-flex justify-content-between mt-4">
      <a asp-action="Index" asp-route-ogrenciId="@Model.OgrenciId" class="btn btn-secondary">
     <i class="fas fa-arrow-left me-1"></i>Geri
    </a>
  <a asp-controller="Ogrenciler" asp-action="Details" asp-route-id="@Model.OgrenciId" class="btn btn-primary">
      <i class="fas fa-user me-1"></i>Öðrenci Detayý
   </a>
    </div>
     </div>
   </div>
 </div>
    </div>
</div>
